local LegitShiftLockButton = AimHelperTab:CreateButton({
    Name = "Legit Auto ShiftLock",
    Callback = function()
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local UserInputService = game:GetService("UserInputService")

        local player = Players.LocalPlayer
        local camera = workspace.CurrentCamera

        print("Instant Jump Snap Lock Activated - Veraxcity_R")

        local justJumped = false

        UserInputService.JumpRequest:Connect(function()
            justJumped = true
            task.delay(0.1, function() justJumped = false end)
        end)

        local connection = RunService.RenderStepped:Connect(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end

            local root = char.HumanoidRootPart

            if justJumped then
                local camLook = camera.CFrame.LookVector
                local targetDir = Vector3.new(camLook.X, 0, camLook.Z)
                if targetDir.Magnitude > 0.1 then
                    targetDir = targetDir.Unit
                end
                
                local targetCFrame = CFrame.lookAt(root.Position, root.Position + targetDir)
                
                root.CFrame = targetCFrame
            end
        end)

        print("Test: Jump → body should snap exactly once toward camera, then stop rotating")
    end,
})

local DirectionIdentifierTab = Window:CreateTab("direction Identifier", 4483362458)
local DirectionIdentifierSection = DirectionIdentifierTab:CreateSection("Direction Identifier")

local DirectionArrowButton = DirectionIdentifierTab:CreateButton({
    Name = "direction arrow",
    Callback = function()
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")

        local camera = workspace.CurrentCamera
        local lines = {}

        print("Dark Blue Aim Lines for Everyone Activated")

        local function createLine()
            local line = Drawing.new("Line")
            line.Thickness = 5
            line.Color = Color3.fromRGB(0, 80, 220)
            line.Transparency = 0.6
            return line
        end

        RunService.RenderStepped:Connect(function()
            local currentPlayers = Players:GetPlayers()
            
            while #lines < #currentPlayers do
                table.insert(lines, createLine())
            end
            
            local index = 1
            for _, plr in ipairs(currentPlayers) do
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local root = plr.Character.HumanoidRootPart
                    local torsoPos = root.Position + Vector3.new(0, 2.8, 0)
                    
                    local bodyDir = root.CFrame.LookVector
                    local endPos = torsoPos + bodyDir * 50
                    
                    local p1 = camera:WorldToViewportPoint(torsoPos)
                    local p2 = camera:WorldToViewportPoint(endPos)
                    
                    local line = lines[index]
                    line.From = Vector2.new(p1.X, p1.Y)
                    line.To = Vector2.new(p2.X, p2.Y)
                    line.Visible = true
                    index = index + 1
                end
            end
            
            for i = index, #lines do
                lines[i].Visible = false
            end
        end)

        print("Dark blue lines for all players - from torso, follows body facing")
    end,
})

